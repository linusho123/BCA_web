{
  "name": "bca-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pierce BCA Protein Assay planner, standard curve and unknown calculator \u2014 runs entirely in the browser.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "npm run build && node scripts/standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:features": "gherkin-lint-plus features",
    "format": "prettier --write .",
    "test": "vitest --run",
    "test:unit": "vitest --run --project=unit",
    "test:component": "vitest --run --project=component",
    "test:acceptance": "vitest --run --project=acceptance",
    "test:acceptance:ui": "vitest --run --project=acceptance:ui",
    "verify": "npm run lint:features && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@preact/signals": "2.11.0",
    "@tanstack/preact-table": "9.1.2",
    "echarts": "6.1.0",
    "lucide-preact": "1.31.0",
    "preact": "10.29.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "10.8.1",
    "gherkin-lint-plus": "1.0.2",
    "prettier": "3.9.6",
    "quickpickle": "1.11.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-preact": "1.0.0"
  }
}
